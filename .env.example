# ==========================================
# CloudNode Environment Variables
# Copy to .env and fill with your values
# ==========================================

# Docker Image (required for deploy)
IMAGE_NAME=ghcr.io/username/cloud-node
IMAGE_TAG=latest

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Security (32 bytes hex string)
ENCRYPTION_KEY=your_32byte_hex_key_here_64chars

# VPN Admin
VPN_ADMIN_USERNAME=admin
VPN_ADMIN_PASSWORD=secure_password_here

# Database
DB_PASSWORD=your_db_password_here

# Domain
DOMAIN_NAME=your-domain.com

# Infrastructure
INFRASTRUCTURE_IP_LIST=62.60.229.227

# GitHub Container Registry
GHCR_USERNAME=your_github_username
GHCR_TOKEN=ghp_your_token_here

# Optional
REDIS_PASSWORD=
REALITY_PUBLIC_KEY=
REALITY_SHORT_ID=
