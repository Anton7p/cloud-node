# ==========================================
# CloudNode Application Environment Configuration
# Auto-generated by Ansible from GitHub Actions
# ==========================================

# Application Settings
NODE_ENV=production

# Database Configuration
DATABASE_URL="postgresql://postgres:{{ db_password }}@db:5432/cloudnode?schema=public"
DB_PASSWORD="{{ db_password }}"

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN="{{ telegram_bot_token }}"

# Security
ENCRYPTION_KEY="{{ encryption_key }}"

# Docker Image
DOCKER_IMAGE_NAME="{{ image_name }}"

# Redis Configuration (static values - container name and default port)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD="{{ redis_password }}"

# Marzban Panel Integration
MARZBAN_URL=http://marzban:8000
VPN_ADMIN_USERNAME="{{ vpn_admin_username }}"
VPN_ADMIN_PASSWORD="{{ vpn_admin_password }}"

# Infrastructure Settings
INFRASTRUCTURE_IP_LIST='{{ infrastructure_ip_list }}'
DOMAIN_NAME="{{ domain_name }}"
MARZBAN_NODE_CERT_DIR=/var/www/marzban_node/var
MARZBAN_INBOUND_TAG="{{ marzban_inbound_tag }}"

# XTLS Reality Keys (for subscription URLs)
REALITY_PUBLIC_KEY="{{ reality_public_key }}"
REALITY_SHORT_ID="{{ reality_short_id }}"

# GitHub Container Registry (for docker login)
GHCR_USERNAME="{{ ghcr_username }}"
GHCR_TOKEN="{{ ghcr_token }}"

