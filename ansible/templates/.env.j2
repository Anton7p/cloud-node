# ==========================================
# CloudNode Application Environment Configuration
# Auto-generated by Ansible from GitHub Actions
# ==========================================

# Application Settings
NODE_ENV=production

# Database Configuration
DATABASE_URL="postgresql://postgres:{{ db_password }}@db:5432/cloudnode?schema=public"
DB_PASSWORD={{ db_password }}

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN="{{ telegram_bot_token }}"

# Security
ENCRYPTION_KEY="{{ encryption_key }}"

# Docker Image
DOCKER_IMAGE_NAME="{{ image_name }}"

# Redis Configuration (static values - container name and default port)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD="{{ vpn_admin_password }}"

# VPN panel API base (Docker: service name marzban, port 8000)
VPN_PANEL_URL={% if vpn_panel_url is defined and vpn_panel_url | length > 0 %}{{ vpn_panel_url }}{% else %}http://marzban:8000{% endif %}

VPN_ADMIN_USERNAME="{{ vpn_admin_username }}"
VPN_ADMIN_PASSWORD="{{ vpn_admin_password }}"

# Infrastructure Settings
INFRASTRUCTURE_IP_LIST='{{ infrastructure_ip_list | to_json }}'
DOMAIN_NAME="{{ domain_name }}"
MARZBAN_NODE_CERT_DIR=/var/www/marzban_node/var
MARZBAN_INBOUND_TAG="{{ marzban_inbound_tag }}"

# XTLS Reality Keys (for subscription URLs)
REALITY_PUBLIC_KEY={{ ansible_facts.reality_public_key | default('') }}
REALITY_PRIVATE_KEY={{ ansible_facts.reality_private_key | default('') }}
REALITY_SHORT_ID={{ ansible_facts.reality_short_id | default('') }}

# ==========================================
# Generated by Ansible
# ==========================================
